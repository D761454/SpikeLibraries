# Auto detect text files and perform LF normalization
* text=auto

*.c text
*.cpp text
*.h text
*.hpp text

*.md text
*.txt text

*.bat text

*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.natvis text eol=crlf

Makefile text eol=lf
*.sh text eol=lf
*.pbxproj text eol=lf
*.storyboard text eol=lf
*.plist text eol=lf

*.lib binary